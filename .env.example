# Crawling config
USER_AGENT="DocsCrawler/1.0 (Standalone)"
MAX_REQUESTS_PER_SECOND=1

# Cấu hình Local LLM (Ollama)
OLLAMA_MODEL="llama3"
OLLAMA_HOST="http://localhost:11434"

# MCP Config (Dùng để lấy kết quả tìm kiếm tự động)
# Câu lệnh chạy MCP server qua stdio
# Đối với Tavily (cần TAVILY_API_KEY)
TAVILY_API_KEY=YOUR_TAVILY_API_KEY_HERE
MCP_TAVILY_COMMAND="npx,-y,tavily-mcp"

# Đối với Exa (cần EXA_API_KEY)
EXA_API_KEY=YOUR_EXA_API_KEY_HERE
MCP_EXA_COMMAND="npx,-y,exa-mcp-server"

# Cấu hình CSDL SQLite (Lưu thành file để dễ kiểm soát trên IDE)
DATABASE_URL="sqlite:///data/export/docscrawlerdb.sqlite"
